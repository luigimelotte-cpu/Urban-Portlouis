# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL 15+ with the pgvector extension available.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lumen"

# ── Session / admin ─────────────────────────────────────────────────────────
# Random 32+ char string used to sign session cookies.
SESSION_SECRET="change-me-to-a-long-random-string"
# Token required to open /admin (model routing, providers, global content cap).
ADMIN_TOKEN="change-me-admin"

# ── Model providers (all optional) ──────────────────────────────────────────
# With no key set, the built-in "mock" provider is used so the app runs offline.
# Providers are configured in the admin panel; these are only the secrets.
# The admin panel references a key by the NAME of its env var, never its value.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OPENAI_MODEL=""   # used when the OpenAI provider row is first created
# Any OpenAI-compatible endpoint (OpenRouter, Together, Groq, vLLM, Ollama, LM Studio…)
OPENAI_COMPAT_API_KEY=""
OPENAI_COMPAT_BASE_URL=""
OPENAI_COMPAT_MODEL=""

# ── Embeddings ──────────────────────────────────────────────────────────────
# "openai" (uses OPENAI_API_KEY / EMBEDDING_BASE_URL) or "local" (offline hashing
# embeddings — good enough for dev, not for production recall quality).
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_BASE_URL=""
# Must match the vector(...) dimension in the migration. Do not change casually.
EMBEDDING_DIM="768"

# ── Content ─────────────────────────────────────────────────────────────────
# Platform-wide ceiling: SAFE | MATURE | ADULT. Admin panel can lower it further.
CONTENT_MODE_CEILING="ADULT"
